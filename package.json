{
  "name": "qys-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:seed": "pnpm --filter @qys/api db:seed",
    "build:api": "pnpm --filter @qys/shared build && pnpm --filter @qys/api build"
  },
  "devDependencies": {
    "turbo": "^2.0.12",
    "typescript": "^5.6.3"
  }
}
