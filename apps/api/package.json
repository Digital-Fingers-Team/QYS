{
  "name": "@qys/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @qys/shared build",
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @qys/shared build && tsc -p tsconfig.json",
    "prestart": "pnpm --filter @qys/shared build",
    "start": "node dist/server.js",
    "lint": "echo 'No lint configured for api'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:seed": "tsx src/seed.ts",
    "generate:center-accounts": "tsx scripts/generate-center-accounts.ts"
  },
  "dependencies": {
    "@qys/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.0",
    "multer": "^2.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.7.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
