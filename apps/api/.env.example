PORT=4000
NODE_ENV=development
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=qys-api
JWT_AUDIENCE=qys-web
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
EXCEL_MAX_UPLOAD_MB=5
JSON_BODY_LIMIT=100kb
TRUST_PROXY=false

# Optional development seed overrides.
SEED_ADMIN_PASSWORD=AdminDevPass!2026
SEED_CENTER_PASSWORD=CenterDevPass!2026
SEED_USER_PASSWORD=UserDevPass!2026
